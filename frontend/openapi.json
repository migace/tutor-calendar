{
  "components": {
    "schemas": {
      "AvailabilityIn": {
        "properties": {
          "rules": {
            "items": {
              "$ref": "#/components/schemas/WeeklyRuleModel"
            },
            "maxItems": 70,
            "title": "Rules",
            "type": "array"
          }
        },
        "required": [
          "rules"
        ],
        "title": "AvailabilityIn",
        "type": "object"
      },
      "AvailabilityOut": {
        "properties": {
          "lesson_minutes": {
            "title": "Lesson Minutes",
            "type": "integer"
          },
          "rules": {
            "items": {
              "$ref": "#/components/schemas/WeeklyRuleModel"
            },
            "title": "Rules",
            "type": "array"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "timezone",
          "lesson_minutes",
          "rules"
        ],
        "title": "AvailabilityOut",
        "type": "object"
      },
      "BookingIn": {
        "properties": {
          "start": {
            "description": "Start of the slot to book, exactly as returned by the slots endpoint",
            "format": "date-time",
            "title": "Start",
            "type": "string"
          },
          "student_email": {
            "format": "email",
            "maxLength": 254,
            "title": "Student Email",
            "type": "string"
          },
          "student_name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Student Name",
            "type": "string"
          }
        },
        "required": [
          "start",
          "student_name",
          "student_email"
        ],
        "title": "BookingIn",
        "type": "object"
      },
      "BookingOut": {
        "properties": {
          "end": {
            "format": "date-time",
            "title": "End",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "start": {
            "format": "date-time",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "id",
          "start",
          "end"
        ],
        "title": "BookingOut",
        "type": "object"
      },
      "DayOut": {
        "properties": {
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "lessons": {
            "items": {
              "$ref": "#/components/schemas/LessonOut"
            },
            "title": "Lessons",
            "type": "array"
          }
        },
        "required": [
          "date",
          "lessons"
        ],
        "title": "DayOut",
        "type": "object"
      },
      "ErrorOut": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthOut": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "LessonOut": {
        "properties": {
          "end": {
            "format": "date-time",
            "title": "End",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "start": {
            "format": "date-time",
            "title": "Start",
            "type": "string"
          },
          "student_email": {
            "title": "Student Email",
            "type": "string"
          },
          "student_name": {
            "title": "Student Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "start",
          "end",
          "student_name",
          "student_email"
        ],
        "title": "LessonOut",
        "type": "object"
      },
      "ProfileOut": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "lesson_minutes": {
            "title": "Lesson Minutes",
            "type": "integer"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "display_name",
          "email",
          "timezone",
          "lesson_minutes"
        ],
        "title": "ProfileOut",
        "type": "object"
      },
      "SignInIn": {
        "properties": {
          "token": {
            "maxLength": 200,
            "minLength": 20,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "SignInIn",
        "type": "object"
      },
      "SignInLinkIn": {
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "SignInLinkIn",
        "type": "object"
      },
      "SlotOut": {
        "properties": {
          "end": {
            "description": "UTC instant the lesson ends",
            "format": "date-time",
            "title": "End",
            "type": "string"
          },
          "start": {
            "description": "UTC instant the lesson starts",
            "format": "date-time",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "title": "SlotOut",
        "type": "object"
      },
      "SlotsResponse": {
        "properties": {
          "slots": {
            "items": {
              "$ref": "#/components/schemas/SlotOut"
            },
            "title": "Slots",
            "type": "array"
          },
          "tutor": {
            "$ref": "#/components/schemas/TutorOut"
          }
        },
        "required": [
          "tutor",
          "slots"
        ],
        "title": "SlotsResponse",
        "type": "object"
      },
      "TutorOut": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "lesson_minutes": {
            "title": "Lesson Minutes",
            "type": "integer"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "timezone": {
            "description": "IANA zone the tutor's schedule is defined in",
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "display_name",
          "timezone",
          "lesson_minutes"
        ],
        "title": "TutorOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WeekOut": {
        "properties": {
          "days": {
            "description": "Monday to Sunday",
            "items": {
              "$ref": "#/components/schemas/DayOut"
            },
            "title": "Days",
            "type": "array"
          },
          "next": {
            "description": "A date in the week after this one",
            "format": "date",
            "title": "Next",
            "type": "string"
          },
          "previous": {
            "description": "A date in the week before this one",
            "format": "date",
            "title": "Previous",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          },
          "today": {
            "description": "Today on the tutor's calendar",
            "format": "date",
            "title": "Today",
            "type": "string"
          }
        },
        "required": [
          "timezone",
          "today",
          "previous",
          "next",
          "days"
        ],
        "title": "WeekOut",
        "type": "object"
      },
      "WeeklyRuleModel": {
        "properties": {
          "end": {
            "format": "time",
            "title": "End",
            "type": "string"
          },
          "start": {
            "description": "Wall-clock time in the tutor's zone, to the minute",
            "format": "time",
            "title": "Start",
            "type": "string"
          },
          "weekday": {
            "description": "0 is Monday",
            "maximum": 6.0,
            "minimum": 0.0,
            "title": "Weekday",
            "type": "integer"
          }
        },
        "required": [
          "weekday",
          "start",
          "end"
        ],
        "title": "WeeklyRuleModel",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Tutor Calendar API",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/links": {
      "post": {
        "description": "Always answers 202, whether or not the address belongs to a tutor, so it cannot be used to find out who has an account.",
        "operationId": "request_sign_in_link_api_v1_auth_links_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInLinkIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ask for a sign-in link by e-mail",
        "tags": [
          "sign-in"
        ]
      }
    },
    "/api/v1/auth/session": {
      "delete": {
        "operationId": "sign_out_api_v1_auth_session_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sign out of this browser",
        "tags": [
          "sign-in"
        ]
      },
      "post": {
        "operationId": "sign_in_api_v1_auth_session_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "The link is expired, used or unknown"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sign in with the token from a sign-in link",
        "tags": [
          "sign-in"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "me_api_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not signed in"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "The signed-in tutor",
        "tags": [
          "tutor panel"
        ]
      }
    },
    "/api/v1/me/availability": {
      "get": {
        "operationId": "availability_api_v1_me_availability_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not signed in"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "The hours the tutor teaches each week",
        "tags": [
          "tutor panel"
        ]
      },
      "put": {
        "description": "Lessons that are already booked are not affected.",
        "operationId": "change_availability_api_v1_me_availability_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AvailabilityIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not signed in"
          },
          "422": {
            "description": "The hours overlap or end before they start"
          }
        },
        "summary": "Replace the hours the tutor teaches each week",
        "tags": [
          "tutor panel"
        ]
      }
    },
    "/api/v1/me/week": {
      "get": {
        "operationId": "week_api_v1_me_week_get",
        "parameters": [
          {
            "description": "Any day of the week to show; defaults to the current week",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Any day of the week to show; defaults to the current week",
              "title": "Date"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeekOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not signed in"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "One week of the tutor's lessons, Monday to Sunday",
        "tags": [
          "tutor panel"
        ]
      }
    },
    "/api/v1/tutors/{slug}/bookings": {
      "post": {
        "operationId": "book_lesson_api_v1_tutors__slug__bookings_post",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "title": "Slug",
              "type": "string"
            }
          },
          {
            "description": "A random value the client makes up for this booking attempt, for example a UUID. Sending the same request again with the same key never books twice; it returns the booking the first attempt created.",
            "in": "header",
            "name": "idempotency-key",
            "required": true,
            "schema": {
              "description": "A random value the client makes up for this booking attempt, for example a UUID. Sending the same request again with the same key never books twice; it returns the booking the first attempt created.",
              "maxLength": 64,
              "minLength": 16,
              "pattern": "^[A-Za-z0-9_-]+$",
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingOut"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "Idempotency-Replayed": {
                "description": "'true' when this repeated an earlier request",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "No such tutor"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "The time cannot be booked: someone else has it, it is too soon, or the tutor does not offer it. Fetch the slots again and pick another."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Book one lesson with a tutor",
        "tags": [
          "bookings"
        ]
      }
    },
    "/api/v1/tutors/{slug}/slots": {
      "get": {
        "operationId": "list_slots_api_v1_tutors__slug__slots_get",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "title": "Slug",
              "type": "string"
            }
          },
          {
            "description": "Start of the window; defaults to the earliest bookable",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Start of the window; defaults to the earliest bookable",
              "title": "From"
            }
          },
          {
            "description": "End of the window; defaults to 14 days after the start",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "End of the window; defaults to 14 days after the start",
              "title": "To"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SlotsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No such tutor"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Slots that can still be booked with a tutor",
        "tags": [
          "slots"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "live_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness: the process is up",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness: the database answers",
        "tags": [
          "health"
        ]
      }
    }
  }
}
