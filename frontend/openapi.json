          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthOut": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "SlotOut": {
        "properties": {
          "end": {
            "description": "UTC instant the lesson ends",
            "format": "date-time",
            "title": "End",
            "type": "string"
          },
          "start": {
            "description": "UTC instant the lesson starts",
            "format": "date-time",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "title": "SlotOut",
        "type": "object"
      },
      "SlotsResponse": {
        "properties": {
          "slots": {
