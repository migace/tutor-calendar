            "title": "Display Name",
            "type": "string"
          },
          "lesson_minutes": {
            "title": "Lesson Minutes",
            "type": "integer"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "timezone": {
            "description": "IANA zone the tutor's schedule is defined in",
