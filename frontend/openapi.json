{
  "components": {
    "schemas": {
      "BookingIn": {
        "properties": {
          "start": {
            "description": "Start of the slot to book, exactly as returned by the slots endpoint",
            "format": "date-time",
            "title": "Start",
            "type": "string"
          },
          "student_email": {
            "format": "email",
            "maxLength": 254,
            "title": "Student Email",
            "type": "string"
          },
          "student_name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Student Name",
            "type": "string"
          }
        },
        "required": [
          "start",
          "student_name",
          "student_email"
        ],
        "title": "BookingIn",
        "type": "object"
      },
      "BookingOut": {
        "properties": {
          "end": {
            "format": "date-time",
            "title": "End",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "start": {
            "format": "date-time",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "id",
          "start",
          "end"
        ],
        "title": "BookingOut",
        "type": "object"
      },
      "ErrorOut": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthOut": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "SlotOut": {
        "properties": {
          "end": {
            "description": "UTC instant the lesson ends",
            "format": "date-time",
            "title": "End",
            "type": "string"
          },
          "start": {
            "description": "UTC instant the lesson starts",
            "format": "date-time",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "title": "SlotOut",
        "type": "object"
      },
      "SlotsResponse": {
        "properties": {
          "slots": {
            "items": {
              "$ref": "#/components/schemas/SlotOut"
            },
            "title": "Slots",
            "type": "array"
          },
          "tutor": {
            "$ref": "#/components/schemas/TutorOut"
          }
        },
        "required": [
          "tutor",
          "slots"
        ],
        "title": "SlotsResponse",
        "type": "object"
      },
      "TutorOut": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "lesson_minutes": {
            "title": "Lesson Minutes",
            "type": "integer"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "timezone": {
            "description": "IANA zone the tutor's schedule is defined in",
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "display_name",
          "timezone",
          "lesson_minutes"
        ],
        "title": "TutorOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Tutor Calendar API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/tutors/{slug}/bookings": {
      "post": {
        "operationId": "book_lesson_api_v1_tutors__slug__bookings_post",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "title": "Slug",
              "type": "string"
            }
          },
          {
            "description": "A random value the client makes up for this booking attempt, for example a UUID. Sending the same request again with the same key never books twice; it returns the booking the first attempt created.",
            "in": "header",
            "name": "idempotency-key",
            "required": true,
            "schema": {
              "description": "A random value the client makes up for this booking attempt, for example a UUID. Sending the same request again with the same key never books twice; it returns the booking the first attempt created.",
              "maxLength": 64,
              "minLength": 16,
              "pattern": "^[A-Za-z0-9_-]+$",
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingOut"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "Idempotency-Replayed": {
                "description": "'true' when this repeated an earlier request",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "No such tutor"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "The time cannot be booked: someone else has it, it is too soon, or the tutor does not offer it. Fetch the slots again and pick another."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Book one lesson with a tutor",
        "tags": [
          "bookings"
        ]
      }
    },
    "/api/v1/tutors/{slug}/slots": {
      "get": {
        "operationId": "list_slots_api_v1_tutors__slug__slots_get",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "title": "Slug",
              "type": "string"
            }
          },
          {
            "description": "Start of the window; defaults to the earliest bookable",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Start of the window; defaults to the earliest bookable",
              "title": "From"
            }
          },
          {
            "description": "End of the window; defaults to 14 days after the start",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "End of the window; defaults to 14 days after the start",
              "title": "To"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SlotsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No such tutor"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Slots that can still be booked with a tutor",
        "tags": [
          "slots"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "live_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness: the process is up",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness: the database answers",
        "tags": [
          "health"
        ]
      }
    }
  }
}
