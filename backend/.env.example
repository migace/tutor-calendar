# Copy to .env to override the defaults in src/tutor_calendar/config.py.
TC_DATABASE_URL=postgresql+asyncpg://tutor:tutor@localhost:5432/tutor_calendar
TC_CORS_ORIGINS=["http://localhost:5173"]
TC_PUBLIC_URL=http://localhost:5173
TC_COOKIE_SECURE=true
# At least 32 characters, random. Without it, booking links break on every restart.
# TC_SECRET_KEY=
