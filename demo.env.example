# Settings for docker-compose.demo.yml. Copy to .env, which git ignores, and fill in.

# The address people open, with https and no trailing slash.
TC_PUBLIC_URL=https://calendar.example.com

# Signs the links for managing a booking and reading a statement.
# Make one with:  openssl rand -hex 32
TC_SECRET_KEY=

# Password of the database, which only the other containers can reach. It goes
# into a URL, so use letters and digits only.
# Make one with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# The port on this machine that the proxy in front connects to.
DEMO_PORT=8000
